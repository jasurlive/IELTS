# server only, used by api/visit.ts: telegram bot that pings you about new visitors
# set these in vercel project env (own bot, not jasurlive.uz's); never prefix with VITE_
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# extra themes (linen, fjord, matte, charcoal, paper) on top of light/dark; set to false to turn them off
VITE_ENABLE_EXTRA_THEMES=true
